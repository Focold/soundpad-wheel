root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
# 本项目用 .NET Framework 4.x 自带的 C# 5 编译器，勿使用 C# 6+ 语法
# （字符串插值、?.、nameof、表达式体成员、元组、out var、自动属性初始化器……）

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2
end_of_line = lf
